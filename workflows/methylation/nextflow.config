params {
    study_id             = null
    coverage_table       = null   // Pre-quantified CpG/DMR methylation TSV (beta or _M/_U count columns)
    samplesheet          = null   // Raw FASTQ mode: sample,fastq_1,fastq_2
    genome_fasta         = null   // Genome FASTA for Bismark index prep in raw FASTQ mode
    bismark_index        = null   // Prebuilt Bismark index directory
    design               = null   // CSV: sample,condition[,covariate...]
    test_level           = null
    reference_level      = 'control'
    feature_type         = 'cpg_site'
    min_coverage         = 5
    min_samples          = 3
    covariate            = null
    sample_comparison    = null
    quality_flags        = 'raw_reanalysis'
    reference_release    = 'GCF_963853765.1-RS_2024_06'
    validate_evidence    = true
    outdir               = "results/methylation/${params.study_id}"
    container_methylation = 'ghcr.io/sr320/aree-methylation:0.1.0'
    container_python      = 'ghcr.io/sr320/aree-python:0.1.0'
}

process {
    cpus = 2
    withLabel: 'bio' { cpus = 4 }
}

profiles {
    standard { }
    micromamba {
        conda.enabled       = true
        conda.useMicromamba = true
        conda.createOptions = '--channel-priority flexible'
        process {
            withLabel: 'bio' { conda = "${projectDir}/environment.yml" }
        }
    }
    test {
        process {
            cpus = 1
            withLabel: 'bio' { cpus = 2 }
        }
    }
    docker {
        docker.enabled = true
        process {
            withLabel: 'bio' { container = params.container_methylation }
            withLabel: 'aree' { container = params.container_python }
        }
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withLabel: 'bio' { container = "docker://${params.container_methylation}" }
            withLabel: 'aree' { container = "docker://${params.container_python}" }
        }
    }
}

manifest {
    name            = 'aree-methylation'
    description     = 'AREE DNA methylation (WGBS/RRBS/DMR) pipeline to harmonizable evidence'
    nextflowVersion = '>=24.04'
}
