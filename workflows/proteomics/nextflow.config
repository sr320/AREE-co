params {
    study_id               = null
    abundance_table        = null   // TSV: feature_id, [gene_symbol, description, feature_id_standardized], <sample> columns
    design                 = null   // CSV: sample,condition[,covariate...]
    test_level             = null
    reference_level        = 'control'
    min_samples            = 3
    log2_transformed       = false
    covariate              = null
    sample_comparison      = null
    quality_flags          = 'raw_reanalysis'
    reference_release      = 'GCF_963853765.1-RS_2024_06'
    validate_evidence      = true
    outdir                 = "results/proteomics/${params.study_id}"
    container_omics_stats  = 'ghcr.io/sr320/aree-omics-stats:0.1.0'
    container_python       = 'ghcr.io/sr320/aree-python:0.1.0'
}

process {
    cpus = 2
}

profiles {
    standard { }
    micromamba {
        conda.enabled       = true
        conda.useMicromamba = true
        conda.createOptions = '--channel-priority flexible'
        process {
            withLabel: 'bio' { conda = "${projectDir}/environment.yml" }
        }
    }
    test {
        process { cpus = 1 }
    }
    docker {
        docker.enabled = true
        process {
            withLabel: 'bio' { container = params.container_omics_stats }
            withLabel: 'aree' { container = params.container_python }
        }
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withLabel: 'bio' { container = "docker://${params.container_omics_stats}" }
            withLabel: 'aree' { container = "docker://${params.container_python}" }
        }
    }
}

manifest {
    name            = 'aree-proteomics'
    description     = 'AREE quantitative proteomics (LFQ/TMT limma) pipeline to harmonizable evidence'
    nextflowVersion = '>=24.04'
}
