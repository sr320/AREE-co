params {
    // Required
    study_id    = null   // registry study ID; names the evidence outputs
    samplesheet = null   // CSV: sample,fastq_1,fastq_2[,strandedness]
    design      = null   // CSV: sample,condition,replicate,run_accession
    tx2gene     = null   // TSV: transcript_id,gene_id (gene IDs as NCBI:GeneID:<id>)
    gff         = null   // gzipped RefSeq GFF of the same release, for gene annotations
    test_level  = null   // design condition compared against reference_level, e.g. heat

    // Salmon index: give a prebuilt one, or transcripts (a decoy-aware gentrome) to build it
    salmon_index  = null
    transcripts   = null
    decoys        = null
    publish_index = false

    // Contrast and filtering (defaults match the AREE PRJNA694496/PRJNA516762 reanalyses)
    reference_level = 'control'
    replicates      = 0      // exact replicates required per condition; 0 = any count >= 2
    min_samples     = 3      // keep genes with >= 10 counts in at least this many samples
    ma_title        = null

    // Evidence export
    sample_comparison = null                           // default: <test_level>_vs_<reference_level>
    quality_flags     = 'raw_reanalysis'               // comma-separated study-level flags
    reference_release = 'GCF_963853765.1-RS_2024_06'

    skip_fastqc = false
    outdir      = "results/rnaseq/${params.study_id}"
    scripts_dir = "${projectDir}/../../scripts"
}

process {
    cpus = 2
    withLabel: 'bio' { cpus = 4 }
    withName: 'SALMON_INDEX|SALMON_QUANT' { cpus = 8 }
}

profiles {
    // Tools already on PATH (salmon, fastqc, Rscript with DESeq2/tximport, and `aree`).
    standard { }
    // salmon, fastqc and R/Bioconductor built from environment.yml with micromamba; `aree` must
    // still be installed in the calling environment. Flexible channel priority is required: under
    // strict priority conda-forge's newer R packages block bioconda's R 4.3 DESeq2/tximport builds.
    micromamba {
        conda.enabled       = true
        conda.useMicromamba = true
        conda.createOptions = '--channel-priority flexible'
        process {
            withLabel: 'bio' { conda = "${projectDir}/environment.yml" }
        }
    }
    // Small CPU allocation for CI and the bundled test data.
    test {
        process {
            cpus = 1
            withLabel: 'bio' { cpus = 2 }
            withName: 'SALMON_INDEX|SALMON_QUANT' { cpus = 2 }
        }
    }
}

manifest {
    name            = 'aree-rnaseq'
    description     = 'AREE RNA-seq reanalysis to harmonizable evidence'
    nextflowVersion = '>=24.04'
}
